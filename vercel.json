{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "functions": {
    "app/api/assistant/chat/route.ts": {
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 23 * * *"
    }
  ]
}
