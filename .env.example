# Postgres (Neon: строка подключения с "-pooler" из консоли Neon как есть; локально — свой Postgres)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/raspison

# Только для Vercel. Миграции при сборке: production всегда; preview — только с MIGRATE_ON_BUILD=1
# (нужно, пока приложение деплоится из ветки). SEED_* на первый запуск создают группу и админа.
# MIGRATE_ON_BUILD=1
# SEED_ADMIN_NAME="Фамилия Имя"
# SEED_INVITE_CODE=M41-XXXX-XXXX

# Секреты (любые длинные случайные строки: `openssl rand -base64 32`)
AUTH_SECRET=change-me
ANON_PEPPER=change-me-too
CRON_SECRET=change-me-three

# Часовой пояс группы
APP_TZ=Asia/Yekaterinburg
NEXT_PUBLIC_APP_TZ=Asia/Yekaterinburg

# PolzaAI (OpenAI-совместимый API, оплата в рублях)
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
OCR_MODEL=google/gemini-3.5-flash
OCR_MODEL_STRONG=anthropic/claude-sonnet-5
# OCR_MOCK=1 — не ходить в Polza, отдавать тестовый ответ (для локальной разработки)

# Файлы: Cloudflare R2 (S3 API). Если не заданы — локальная папка .data/uploads (только для разработки)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raspison
