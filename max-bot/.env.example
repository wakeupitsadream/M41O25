# Бот для MAX — переменные окружения. В проде всё задаётся в Vercel → Settings → Environment Variables
# (Production), здесь — только для локального запуска. Подробно о ключах моделей — docs/MODELS.md.

# Токен бота из MAX (Master Bot / бизнес-кабинет). Последние 6 символов — код привязки владельца.
MAX_BOT_TOKEN=

# Postgres (Neon через Vercel → Storage; локально — свой). Таблицы бот создаёт сам.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/maxbot

# Модели (минимум — Gemini)
GEMINI_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# Необязательно
# MAX_OWNER_ID=              # id владельца вместо привязки кодом
# RASPISON_URL=https://raspison.vercel.app
# RASPISON_BOT_KEY=          # тот же, что BOT_API_KEY в Raspison
# RASPISON_GROUP=М41О25      # только если в Raspison несколько групп
# STUDY_START_YEAR=2025
# CRON_SECRET=
# APP_TZ=Asia/Yekaterinburg
# CHAIN_SOLVE=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b
# PUBLIC_URL=https://example.vercel.app   # адрес вебхука вне Vercel production

# Тесты: npm test
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/maxbot_test
